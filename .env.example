# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Twenty CRM (source of truth) ---
# Self-hosted Twenty instance. One workspace per brokerage tenant.
TWENTY_SERVER_URL=http://localhost:3001
TWENTY_API_KEY=
TWENTY_WORKSPACE_ID=
# Verifies inbound Twenty outbound webhooks. Set the same value in Twenty.
TWENTY_WEBHOOK_SECRET=

# --- WhatsApp Business Cloud API ---
# Resolve these in Meta for Developers. Stored server-side only.
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_WABA_ID=
META_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# --- Dograh voice service ---
# Deploy one Dograh instance, create an organization per tenant.
DOGRAH_API_URL=http://localhost:8000
DOGRAH_API_KEY=
DOGRAH_ORG_ID=
DOGRAH_DEFAULT_WORKFLOW_ID=
DOGRAH_DEFAULT_TELEPHONY_CONFIG_ID=

# --- AI provider ---
# Any one of the keys below enables AI mode. Prefer the Vercel AI Gateway.
AI_GATEWAY_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_PROVIDER=openrouter
AI_MODEL=openrouter/auto
AI_DAILY_SPEND_LIMIT_USD=

# --- MCP server ---
# Optional. If set, clients must send Authorization: Bearer <token>.
MCP_BEARER_TOKEN=

# --- Ingestion ---
# Optional. If set, /api/ingest/leads requires header x-ingest-secret.
N8N_WEBHOOK_SECRET=
